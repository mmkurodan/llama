<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keep the CPU awake while a model/mmproj is downloading so backgrounding the app
         (screen off / app switched away) is less likely to interrupt the transfer. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Restart the API/WebUI foreground service after a reboot when the user had it enabled. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name="com.micklab.llama.LlamaApplication"
        android:label="LLM AI Server with llama.cpp"
        android:theme="@style/AppTheme"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name="com.micklab.llama.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name="com.micklab.llama.SettingsActivity"
            android:label="Settings"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true" />

        <activity
            android:name="com.micklab.llama.DocumentsActivity"
            android:label="Documents"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true" />
            
        <service
            android:name="com.micklab.llama.OllamaForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="llm_inference" />
        </service>

        <!-- Re-assert a persisted "API enabled" intent after a device reboot. On Android 14+ a
             specialUse FGS may not be startable directly from boot; startIfEnabled() degrades
             gracefully and the next app launch re-asserts. -->
        <receiver
            android:name="com.micklab.llama.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Adreno GPU: allow loading the Qualcomm OpenCL driver (vendor lib).
             Used by the libggml-opencl.so DL plugin; required=false so non-OpenCL
             devices still run (GPU just unavailable). -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

    </application>

</manifest>
