<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="com.micklab.llama.LlamaApplication"
        android:label="LLM tester with llama.cpp"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name="com.micklab.llama.MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name="com.micklab.llama.SettingsActivity"
            android:label="Settings"
            android:exported="false" />

        <activity
            android:name="com.micklab.llama.DocumentsActivity"
            android:label="Documents"
            android:exported="false" />
            
        <service
            android:name="com.micklab.llama.OllamaForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="llm_inference" />
        </service>

    </application>

</manifest>
