<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- ① TOP STATUS HEADER: API status / speed / temp / active backend -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#ECEFF1"
            android:padding="10dp">

            <TextView
                android:id="@+id/apiServerStatusMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="API/WebUI: Stopped"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/headerStatsView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="⚡ -- tok/s    🌡 --°C    🧠 --"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- ② PRIMARY ACTIONS (vertical): API on/off / Reset / Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp">

            <Button
                android:id="@+id/apiServerButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Start API/WebUI" />

            <Button
                android:id="@+id/initModelButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Reset" />

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Settings" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="#CCCCCC" />

        <!-- ③ DIRECT RUN SECTION (expanded by default, above the status/log area) -->
        <TextView
            android:id="@+id/directSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:background="#E0E0E0"
            android:text="▼ Direct Run"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/directSectionContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Profile:"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/profileSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/promptLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter Prompt:"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/promptInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="Enter your prompt here"
                android:inputType="textMultiLine"
                android:maxLines="4"
                android:minLines="2" />

            <Button
                android:id="@+id/sendButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="Send" />

            <TextView
                android:id="@+id/outputSectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="Model Output:"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Response area: selectable/copyable (long-press to copy) -->
            <TextView
                android:id="@+id/outputView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="160dp"
                android:background="#F5F5F5"
                android:padding="12dp"
                android:textIsSelectable="true"
                android:text="Output will appear here"
                android:textSize="14sp" />

            <!-- Generation speed (tok/s) + device temperature (also in the top header) -->
            <TextView
                android:id="@+id/statsView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:gravity="end"
                android:text="⚡ -- tok/s    🌡 --°C"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#CCCCCC" />

        <!-- ④ PROCESSING STATUS / LOG AREA (log shown here as a toggle) -->
        <TextView
            android:id="@+id/processingSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Processing Status/Logs:"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <Button
                android:id="@+id/viewLogButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="View Log"
                android:textSize="12sp" />

            <Button
                android:id="@+id/updateLogButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="Update"
                android:textSize="12sp" />

            <Button
                android:id="@+id/clearLogButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="Clear"
                android:textSize="12sp" />

            <Button
                android:id="@+id/downloadLogButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Download"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Processing status / log: selectable/copyable (long-press to copy) -->
        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="160dp"
            android:background="#F0F0F0"
            android:padding="12dp"
            android:textIsSelectable="true"
            android:text="Starting...\n"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
